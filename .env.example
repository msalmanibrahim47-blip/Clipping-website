# =============================================================================
# LongCut — environment variables
# Copy to `.env` at the repo root for local development (read by both the web
# app and the worker). In production set these in Netlify (web) and on the
# worker host. Variables marked [web] / [worker] are only needed there.
# =============================================================================

# --- Database (Postgres 14+: Supabase, Neon, Railway, RDS…) -------------------
# Use a pooled connection string for the web app on Netlify (e.g. Supabase
# pooler :6543 / Neon "-pooler" host). The worker can use a direct connection.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/longcut
# Set to "true" to force TLS (auto-enabled when the URL contains sslmode=require)
DATABASE_SSL=
# Connections per process. Keep small (2–5) on serverless.
DATABASE_POOL_MAX=5

# --- Auth & secrets [web] ------------------------------------------------------
# Random string, at least 32 chars:  openssl rand -base64 48
AUTH_SECRET=
# 32 bytes, base64 — encrypts per-user API keys:  openssl rand -base64 32   [web + worker]
APP_ENCRYPTION_KEY=
# Set to "false" to close public sign-ups
ALLOW_SIGNUPS=true
# Max upload size in bytes (default 100 GB)
MAX_UPLOAD_BYTES=

# --- Object storage (S3-compatible: Cloudflare R2, AWS S3, MinIO, B2…) --------
STORAGE_PROVIDER=r2
STORAGE_BUCKET=longcut
# R2: https://<account-id>.r2.cloudflarestorage.com   AWS S3: leave empty
STORAGE_ENDPOINT=
# R2: "auto". AWS: e.g. us-east-1
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# "true" for MinIO / path-style endpoints
STORAGE_FORCE_PATH_STYLE=false
# Only when browsers reach storage under a different host than the servers
# (e.g. docker-compose MinIO: http://localhost:9000)
STORAGE_PUBLIC_ENDPOINT=

# --- AI intelligence layer [worker] -------------------------------------------
# anthropic (default) | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Main model (boundary refinement, scoring, packages) and a cheaper/faster model
# for bulk passes (topic mapping, caption translation).
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_FAST_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_FAST_MODEL=gpt-5-mini
# Optional OpenAI-compatible endpoint
OPENAI_BASE_URL=

# --- Speech-to-text [worker] ---------------------------------------------------
# deepgram | openai | groq | local   (auto-selected from available keys if empty)
STT_PROVIDER=
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
OPENAI_STT_MODEL=whisper-1
# local faster-whisper (python/transcribe.py)
LOCAL_WHISPER_MODEL=large-v3
LOCAL_WHISPER_DEVICE=auto
LOCAL_WHISPER_COMPUTE_TYPE=default
# Optional Whisper style prompt override
TRANSCRIBE_PROMPT=
TRANSCRIBE_CHUNK_SECONDS=600
TRANSCRIBE_CONCURRENCY=

# --- YouTube -------------------------------------------------------------------
# [web] optional: exact duration & metadata via YouTube Data API v3
YOUTUBE_API_KEY=
# [worker] optional Netscape cookies file for yt-dlp
YTDLP_COOKIES_FILE=

# --- Worker tuning [worker] ---------------------------------------------------
# heavy = FFmpeg jobs (process/render/preview); light = LLM/probe/cleanup jobs.
# Run separate worker services per role to scale them independently.
WORKER_ROLES=heavy,light
WORKER_HEAVY_CONCURRENCY=1
WORKER_LIGHT_CONCURRENCY=4
# Needs room for YouTube downloads (a 10h 1080p source can be 10–20 GB)
WORKER_TMP_DIR=/tmp/longcut
# Health check port (Railway/Fly/Render)
PORT=8080
# libx264 preset / quality; or RENDER_ENCODER=h264_nvenc on GPU hosts
RENDER_PRESET=medium
RENDER_CRF=20
RENDER_ENCODER=libx264
FONTS_DIR=/usr/share/fonts
PREVIEW_ALWAYS_PROXY=false
ANALYSIS_CONCURRENCY=4
ANALYSIS_WINDOW_MINUTES=30
CLEANUP_INTERVAL_MINUTES=60
LOG_LEVEL=info
